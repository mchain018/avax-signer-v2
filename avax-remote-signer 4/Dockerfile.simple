# Build using golang-alpine which already has build tools
FROM fcr.fmr.com/library/golang:1.24-alpine AS builder

# Configure Alpine to use Fidelity Artifactory mirror
RUN echo "https://artifactory.fmr.com/artifactory/alpine-public-alpinelinux/v3.22/main" > /etc/apk/repositories && \
    echo "https://artifactory.fmr.com/artifactory/alpine-public-alpinelinux/v3.22/community" >> /etc/apk/repositories && \
    apk update && apk add --no-cache ca-certificates git gcc musl-dev linux-headers make

# Configure Go and Git to work with corporate certificates
ENV GOPROXY=direct
ENV GOINSECURE=*
RUN git config --global http.sslVerify false

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application with CGO enabled (required for BLS crypto)
RUN CGO_ENABLED=1 go build -o avax-remote-signer ./cmd/signer

# Runtime stage - use same base to avoid package installation
FROM fcr.fmr.com/library/golang:1.24-alpine

# Configure Alpine to use Fidelity Artifactory mirror
RUN echo "https://artifactory.fmr.com/artifactory/alpine-public-alpinelinux/v3.22/main" > /etc/apk/repositories && \
    echo "https://artifactory.fmr.com/artifactory/alpine-public-alpinelinux/v3.22/community" >> /etc/apk/repositories

# Create non-root user
RUN addgroup -g 1000 signer && \
    adduser -D -u 1000 -G signer signer

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/avax-remote-signer .

# Change ownership
RUN chown -R signer:signer /app

# Switch to non-root user
USER signer

# Expose HTTP API port
EXPOSE 9090

# Health check using wget (already available in golang-alpine)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9090/health || exit 1

ENTRYPOINT ["/app/avax-remote-signer"]
CMD ["--config", "/config/config.yaml"]
